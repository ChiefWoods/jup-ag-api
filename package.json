{
  "name": "@jup-ag/api",
  "version": "6.0.48",
  "homepage": "https://github.com/jup-ag/jupiter-quote-api-node",
  "repository": {
    "type": "git",
    "url": "https://github.com/jup-ag/jupiter-quote-api-node.git"
  },
  "description": "Jupiter API client",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "typings": "dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "bun run openapi-gen && tsdown",
    "openapi-gen": "openapi-generator-cli generate -i swagger.yaml -o generated -g typescript-fetch --skip-validate-spec --additional-properties=supportsES6=true,typescriptThreePlus=true",
    "openapi-gen-rust": "openapi-generator-cli generate -i swagger.yaml -o generated -g rust"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.9.0",
    "@types/bun": "^1.3.14",
    "tsdown": "^0.22.14",
    "typescript": "^5.1.6"
  },
  "files": [
    "dist"
  ]
}
