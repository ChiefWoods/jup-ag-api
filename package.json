{
  "name": "jupiter-api",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run generate:ts && bun run --filter jupiter-api-ts build",
    "changeset": "changeset",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "prepare-openapi": "bun run scripts/prepare-openapi.ts",
    "openapi-gen:ts": "openapi-ts -f openapi-ts.config.ts",
    "generate:ts": "rm -rf packages/jupiter-api-ts/generated && bun run prepare-openapi && bun run openapi-gen:ts",
    "prepare": "husky",
    "typecheck": "bun run --filter jupiter-api-ts typecheck",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/bun": "^1.3.14",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tsdown": "^0.22.14",
    "typescript": "6.0.3"
  }
}
